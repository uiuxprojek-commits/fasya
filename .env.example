# ==============================================================================
# TATADANA FINTECH SAAS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env.local dan isi nilai kredensial yang valid.
# PERINGATAN KEAMANAN: Jangan commit secret asli ke Git atau mengeksposnya ke publik!

# ------------------------------------------------------------------------------
# 1. APLIKASI WEB & DOMAIN
# ------------------------------------------------------------------------------
# URL publik aplikasi frontend (contoh: https://tatadana.id atau http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# URL dasar webhook yang bisa diakses oleh Telegram & Midtrans
# Untuk lokal development bisa menggunakan URL tunnel (contoh: ngrok / cloudflared)
WEBHOOK_BASE_URL="http://localhost:3000"

# Kunci rahasia untuk trigger cron job internal (misal: /api/cron/reminders)
CRON_SECRET="ganti_dengan_random_secret_string_minimal_32_karakter"

# Master Encryption Key (32 bytes hex string untuk enkripsi simetris AES-256-GCM API key)
# Generate dengan: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 2. SUPABASE (POSTGRESQL, AUTH, STORAGE, REALTIME)
# ------------------------------------------------------------------------------
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase config (JANGAN PERNAH diekspos dengan prefix NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="tatadana-receipts"

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT
# ------------------------------------------------------------------------------
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
# Token rahasia verifikasi webhook Telegram (header X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_BOT_SECRET_TOKEN="random_telegram_webhook_secret_verification_token"
# Username bot tanpa '@' (contoh: TataDanaBot)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="TataDanaBot"

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (MULTI-PROVIDER: GEMINI, OPENAI, DEEPSEEK)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Default recommended provider)
GEMINI_API_KEY="AIzaSy..."

# OpenAI API Key (GPT-4o mini / Whisper STT)
OPENAI_API_KEY="sk-..."

# DeepSeek API Key (DeepSeek-V3 / DeepSeek-R1)
DEEPSEEK_API_KEY="sk-..."

# Mode default AI: 'single' | 'failover'
AI_ROUTING_MODE="failover"
# Primary provider default: 'gemini' | 'openai' | 'deepseek'
AI_PRIMARY_PROVIDER="gemini"

# ------------------------------------------------------------------------------
# 5. MIDTRANS PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Dapatkan dari Dashboard Midtrans -> Settings -> Access Keys
MIDTRANS_SERVER_KEY="SB-Mid-server-..."
MIDTRANS_CLIENT_KEY="SB-Mid-client-..."
# Set 'true' untuk mode produksi, 'false' untuk Sandbox testing
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_MERCHANT_ID="G123456789"
